# Copy to .env (git-ignored) and fill in. server.py reads .env on start; existing
# environment variables take precedence. Never commit the real .env.

# Pepper for hashing email codes. Generate once per environment:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
EMAIL_VERIFICATION_SECRET=

# Outgoing mail. Without SMTP_HOST the server only writes codes to the email_outbox table.
# Yandex Mail: create an app password at id.yandex.ru (Security > App passwords > Mail).
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Sender shown to users; Yandex requires it to match SMTP_USER
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SmartContractum
